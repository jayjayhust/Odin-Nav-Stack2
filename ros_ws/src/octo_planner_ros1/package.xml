<?xml version="1.0"?>
<package format="2">
  <name>octo_planner_ros1</name>
  <version>0.1.0</version>
  <description>
    ROS1 port of the 3D occupancy planner from jie_3d_nav/octo_planner. Serves
    the same nav_interfaces/PlanPath contract as map_planner, so mission_manager
    can switch backends with the plan_service parameter only.
  </description>
  <maintainer email="jayjayhust@users.noreply.github.com">jayjayhust</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>nav_msgs</depend>
  <depend>nav_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>libpcl-all-dev</depend>
</package>
