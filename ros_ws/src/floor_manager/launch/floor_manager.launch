<launch>
  <!-- Floor list: ${REPO_ROOT} inside the file expands to repo_root below. -->
  <arg name="floors_config"
       default="$(find ons2_bringup)/../../../robots/go2/floors.yaml"/>
  <arg name="odin_config_path"
       default="$(find odin_ros_driver)/config/control_command.yaml"/>
  <arg name="odin_restart_script"
       default="$(find floor_manager)/../../../scripts/ons2_odin_restart.sh"/>
  <arg name="odin_restart_mode" default="process"/>
  <arg name="odin_restart_unit" default="odin1-driver"/>
  <arg name="repo_root" default="$(optenv GO2_ROOT)"/>
  <arg name="initial_floor" default="1F"/>
  <arg name="auto_publish_initial_map" default="true"/>
  <arg name="map_topic" default="/map"/>
  <arg name="map_frame" default="map"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="reloc_timeout_sec" default="120.0"/>
  <arg name="reloc_stable_sec" default="2.0"/>

  <!-- Loads /floor_manager/floors for the node. -->
  <rosparam file="$(arg floors_config)" command="load" ns="floor_manager"/>

  <node pkg="floor_manager" type="floor_manager_node" name="floor_manager"
        output="screen" respawn="true" respawn_delay="3">
    <param name="map_topic" value="$(arg map_topic)"/>
    <param name="map_frame" value="$(arg map_frame)"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
    <param name="odin_config_path" value="$(arg odin_config_path)"/>
    <param name="odin_restart_script" value="$(arg odin_restart_script)"/>
    <param name="odin_restart_mode" value="$(arg odin_restart_mode)"/>
    <param name="odin_restart_unit" value="$(arg odin_restart_unit)"/>
    <param name="repo_root" value="$(arg repo_root)"/>
    <param name="initial_floor" value="$(arg initial_floor)"/>
    <param name="auto_publish_initial_map" value="$(arg auto_publish_initial_map)"/>
    <param name="sliding_map_clear_service" value="/sliding_map_node/clear"/>
    <param name="neupan_stop_topic" value="/neupan/stop"/>
    <param name="mission_pause_service" value="/waypoint_manager/pause"/>
    <param name="plan_service" value="/map_planner/plan"/>
    <param name="reloc_timeout_sec" value="$(arg reloc_timeout_sec)"/>
    <param name="reloc_stable_sec" value="$(arg reloc_stable_sec)"/>
    <param name="planner_ready_timeout_sec" value="8.0"/>
    <param name="inflate_wait_timeout_sec" value="6.0"/>
    <param name="pause_mission_on_switch" value="true"/>
    <param name="zero_vel_on_switch" value="true"/>
  </node>
</launch>
